#!/usr/bin/env python3
"""Stream to a TV on the same network over DLNA/UPnP (AVTransport).

Samsung Smart TVs (and most other TVs, receivers, and media boxes) expose a
UPnP MediaRenderer. We hand it the stream URL; the TV fetches and decodes the
stream itself, so nothing is routed through this machine.

  iptv-cast --discover                     JSON list of renderers on the LAN
  iptv-cast --select --location <desc-url> remember one (~/.config/omarchy-iptv/tv.json)
  iptv-cast --select --host <ip>           same, for a Samsung TV by address
  iptv-cast --forget
  iptv-cast --play --id <id> [--title <t>] play a catalog stream on the TV
  iptv-cast --play <url> [--title <t>]     (runs until the TV stops or it is killed)
  iptv-cast --stop | --pause | --resume | --status

Discovery uses SSDP multicast first; because a host firewall commonly drops
the unicast replies, it also probes the local subnets for the Samsung DLNA
renderer port (9197, 7676 on older sets) so a Samsung TV is found either way.

Playback goes through a local relay by default: TVs probe a URL with HEAD /
Range requests and expect DLNA headers before they accept it, which IPTV
panels do not provide (they answer HEAD with 5xx, redirect to tokenized edge
servers, reset connections). The relay fetches the stream with a player
User-Agent and serves it to the TV like a DLNA server would, on
`relay_port` (tv.json, default 8765) — that port must be open to the LAN in
the host firewall. It serves exactly one stream under a random path and
exits when playback ends; `"relay": false` in tv.json hands the raw URL to
the TV instead.

Stream URLs carry the provider credentials; they never appear on stderr
(redacted to <url>) and never enter the shell (QML passes ids, not URLs).

Exit codes: 2 usage · 3 no TV selected · 4 TV unreachable · 5 TV refused
(UPnP fault) · 6 stream id unknown · 7 relay could not start · 8 TV stopped
with an error.
"""

import argparse
import concurrent.futures
import fcntl
import http.server
import io
import ipaddress
import json
import os
import re
import secrets
import shutil
import signal
import socket
import socketserver
import struct
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
from xml.etree import ElementTree as ET
from xml.sax.saxutils import escape

CONFIG_DIR = os.path.expanduser("~/.config/omarchy-iptv")
TV_JSON = os.path.join(CONFIG_DIR, "tv.json")
PROVIDER_JSON = os.path.join(CONFIG_DIR, "provider.json")
CACHE = os.path.expanduser("~/.cache/omarchy-iptv")
RENDERERS_JSON = os.path.join(CACHE, "renderers.json")
SYNC = os.path.join(os.path.dirname(os.path.abspath(__file__)), "iptv-sync")

USER_AGENT = "omarchy-iptv/1.0 UPnP/1.0 DLNADOC/1.50"
SSDP_ADDR = ("239.255.255.250", 1900)
RENDERER_ST = "urn:schemas-upnp-org:device:MediaRenderer:1"
AVT_TYPE = "urn:schemas-upnp-org:service:AVTransport:1"
NS_DEV = "urn:schemas-upnp-org:device-1-0"
NS_SOAP = "http://schemas.xmlsoap.org/soap/envelope/"
NS_CTL = "urn:schemas-upnp-org:control-1-0"
SAMSUNG_PROBES = [(9197, ["/dmr"]), (7676, ["/smp_%d_" % n for n in range(2, 8)])]
SKIP_IFACES = re.compile(r"^(lo|docker|veth|virbr|waydroid|br-|tun|tap|wg|tailscale|vboxnet|vmnet)")
MAX_HOSTS = 1024
DESC_TIMEOUT = 3
SOAP_TIMEOUT = 15
# Samsung sets pop up "Allow device?" on first contact and hold the request
# until the remote answers, so the first call gets a long leash.
FIRST_CONTACT_TIMEOUT = 45
DEFAULT_LIVE_FORMAT = "ts"
RELAY_PORT = 8765
PLAYER_UA = "VLC/3.0.20 LibVLC/3.0.20"  # panels 403 unknown agents; a player is let through
DLNA_LIVE = "DLNA.ORG_OP=00;DLNA.ORG_CI=0;DLNA.ORG_FLAGS=8D100000000000000000000000000000"
DLNA_FILE = "DLNA.ORG_OP=01;DLNA.ORG_CI=0;DLNA.ORG_FLAGS=01700000000000000000000000000000"
RELAY_CHUNK = 64 * 1024
# TVs parse a file (MKV cues, MP4 atoms) with many tiny open-ended range
# requests a few KB apart, plus jumps to the middle and the end. Reopening
# the provider connection (a redirect round trip) for each would take
# minutes, so a file relay keeps one upstream connection and a window of the
# bytes it already fetched; only real jumps reopen.
CACHE_BYTES = 8 * 1024 * 1024
SKIP_BYTES = 4 * 1024 * 1024  # read-and-discard rather than reopen for jumps this small
CLIENT_TIMEOUT = 20  # a TV that stops reading must not pin the upstream lock
PROBE_RETRIES = 3  # panels answer the odd request with a transient 5xx
# Audio the TV can decode itself. Anything else (DTS, TrueHD, FLAC, Opus,
# Vorbis...) is converted to AC3 on the fly with ffmpeg, video copied as is,
# muxed to MPEG-TS - Samsung sets have had no DTS decoder since 2018.
TV_AUDIO = {"aac", "ac3", "eac3", "mp3", "mp2", "pcm_s16le", "pcm_s16be", "wmav2", "wmapro"}
PROBE_BYTES = 4 * 1024 * 1024  # enough of a file head for ffprobe to list its streams
POLL_SECONDS = 3.0
START_GRACE = 60.0  # how long the TV may sit in TRANSITIONING/STOPPED before we call it failed
MIME = {
    ".ts": "video/mpeg",
    ".m3u8": "application/vnd.apple.mpegurl",
    ".mp4": "video/mp4",
    ".m4v": "video/mp4",
    ".mkv": "video/x-matroska",
    ".avi": "video/x-msvideo",
    ".mov": "video/quicktime",
    ".webm": "video/webm",
    ".mpg": "video/mpeg",
    ".mpeg": "video/mpeg",
    ".wmv": "video/x-ms-wmv",
    ".flv": "video/x-flv",
}


# --- output ------------------------------------------------------------------

def redact(text):
    return re.sub(r"https?://\S+", "<url>", str(text))


def warn(msg):
    print(redact(msg), file=sys.stderr)


def die(msg, code=1):
    warn(msg)
    sys.exit(code)


class TvError(Exception):
    def __init__(self, msg, code=4):
        super().__init__(msg)
        self.code = code


# --- config -----------------------------------------------------------------

def load_tv():
    try:
        with open(TV_JSON, encoding="utf-8") as f:
            cfg = json.load(f)
        return cfg if isinstance(cfg, dict) else {}
    except (OSError, ValueError):
        return {}


def save_json(path, obj):
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(obj, f, ensure_ascii=False, indent=1)
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


# --- device descriptions ----------------------------------------------------

def http_get(url, timeout=DESC_TIMEOUT):
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read(1 << 20)


def parse_description(xml_bytes, location):
    """Renderer summary from a UPnP device description, or None if it has no
    AVTransport service (a media server, a router, ...)."""
    try:
        root = ET.fromstring(xml_bytes)
    except ET.ParseError:
        return None
    ns = {"d": NS_DEV}
    base = location
    ub = root.find("d:URLBase", ns)
    if ub is not None and (ub.text or "").strip():
        base = ub.text.strip()
    devices = root.findall(".//d:device", ns)
    for dev in devices:
        dtype = (dev.findtext("d:deviceType", "", ns) or "")
        control = None
        for svc in dev.findall("d:serviceList/d:service", ns):
            if (svc.findtext("d:serviceType", "", ns) or "").startswith("urn:schemas-upnp-org:service:AVTransport:"):
                control = svc.findtext("d:controlURL", "", ns) or ""
                break
        if control is None:
            continue
        if "MediaRenderer" not in dtype and "AVTransport" not in control:
            continue
        host = urllib.parse.urlsplit(location).hostname or ""
        return {
            "name": (dev.findtext("d:friendlyName", "", ns) or host).strip(),
            "manufacturer": (dev.findtext("d:manufacturer", "", ns) or "").strip(),
            "model": (dev.findtext("d:modelName", "", ns) or "").strip(),
            "udn": (dev.findtext("d:UDN", "", ns) or "").strip(),
            "location": location,
            "control_url": urllib.parse.urljoin(base, control),
            "host": host,
        }
    return None


def describe(location):
    try:
        return parse_description(http_get(location), location)
    except (urllib.error.URLError, OSError, ValueError):
        return None


# --- discovery --------------------------------------------------------------

def ssdp_search(wait=1.5):
    msg = (
        "M-SEARCH * HTTP/1.1\r\n"
        f"HOST: {SSDP_ADDR[0]}:{SSDP_ADDR[1]}\r\n"
        'MAN: "ssdp:discover"\r\n'
        "MX: 1\r\n"
        f"ST: {RENDERER_ST}\r\n"
        f"USER-AGENT: {USER_AGENT}\r\n\r\n"
    ).encode()
    locations = []
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM, socket.IPPROTO_UDP)
        s.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_TTL, 2)
        s.settimeout(0.3)
        for _ in range(2):
            s.sendto(msg, SSDP_ADDR)
        end = time.monotonic() + wait
        while time.monotonic() < end:
            try:
                data, _ = s.recvfrom(65535)
            except socket.timeout:
                continue
            m = re.search(rb"(?im)^location:\s*(\S+)", data)
            if m:
                loc = m.group(1).decode(errors="replace")
                if loc not in locations:
                    locations.append(loc)
        s.close()
    except OSError:
        pass
    return locations


def local_networks():
    nets = []
    try:
        ifaces = socket.if_nameindex()
    except OSError:
        return nets
    for _, name in ifaces:
        if SKIP_IFACES.match(name):
            continue
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        try:
            req = struct.pack("256s", name.encode()[:15])
            addr = socket.inet_ntoa(fcntl.ioctl(s.fileno(), 0x8915, req)[20:24])   # SIOCGIFADDR
            mask = socket.inet_ntoa(fcntl.ioctl(s.fileno(), 0x891B, req)[20:24])   # SIOCGIFNETMASK
        except OSError:
            continue
        finally:
            s.close()
        try:
            net = ipaddress.IPv4Network(f"{addr}/{mask}", strict=False)
        except ValueError:
            continue
        if net.num_addresses > MAX_HOSTS:  # shrink a huge subnet to the /22 around us
            net = ipaddress.IPv4Network(f"{addr}/22", strict=False)
        nets.append((net, addr))
    return nets


def _tcp_open(ip, port, timeout=0.35):
    s = socket.socket()
    s.settimeout(timeout)
    try:
        s.connect((ip, port))
        return True
    except OSError:
        return False
    finally:
        s.close()


def probe_samsung(nets=None):
    """Find Samsung DLNA renderers by their well-known ports; works when the
    firewall eats SSDP replies. Returns description URLs."""
    nets = local_networks() if nets is None else nets
    targets = []
    for net, me in nets:
        for h in net.hosts():
            ip = str(h)
            if ip != me:
                targets.append(ip)
    if not targets:
        return []
    found = []
    with concurrent.futures.ThreadPoolExecutor(max_workers=128) as ex:
        futs = {ex.submit(_tcp_open, ip, port): (ip, port, paths)
                for ip in targets for port, paths in SAMSUNG_PROBES}
        for f in concurrent.futures.as_completed(futs):
            if f.result():
                found.append(futs[f])
    locations = []
    for ip, port, paths in sorted(found):
        for p in paths:
            loc = f"http://{ip}:{port}{p}"
            try:
                if b"MediaRenderer" in http_get(loc, timeout=1.5):
                    locations.append(loc)
                    break
            except (urllib.error.URLError, OSError, ValueError):
                continue
    return locations


def discover():
    seen = {}
    for loc in ssdp_search() + probe_samsung():
        if loc in seen:
            continue
        d = describe(loc)
        if d:
            seen[loc] = d
    out = []
    udns = set()
    for d in seen.values():
        key = d["udn"] or d["location"]
        if key in udns:
            continue
        udns.add(key)
        out.append(d)
    out.sort(key=lambda d: (d["name"].lower(), d["host"]))
    try:
        save_json(RENDERERS_JSON, out)
    except OSError:
        pass
    return out


# --- SOAP --------------------------------------------------------------------

def soap_call(control_url, action, args=None, timeout=SOAP_TIMEOUT):
    body = "".join(f"<{k}>{escape(str(v))}</{k}>" for k, v in (args or {}).items())
    env = (
        '<?xml version="1.0" encoding="utf-8"?>'
        f'<s:Envelope xmlns:s="{NS_SOAP}" s:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/">'
        f'<s:Body><u:{action} xmlns:u="{AVT_TYPE}">{body}</u:{action}></s:Body></s:Envelope>'
    )
    req = urllib.request.Request(control_url, data=env.encode("utf-8"), headers={
        "Content-Type": 'text/xml; charset="utf-8"',
        "SOAPACTION": f'"{AVT_TYPE}#{action}"',
        "User-Agent": USER_AGENT,
        "Connection": "close",
    })
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return parse_soap_response(r.read(1 << 20), action)
    except urllib.error.HTTPError as e:
        with e:
            fault = soap_fault(e.read(1 << 20))
        raise TvError(f"TV refused {action}: {fault or f'HTTP {e.code}'}", 5)
    except (urllib.error.URLError, OSError) as e:
        raise TvError(f"TV unreachable ({getattr(e, 'reason', e)})", 4)


def soap_fault(xml_bytes):
    try:
        root = ET.fromstring(xml_bytes)
    except ET.ParseError:
        return ""
    code = root.findtext(f".//{{{NS_CTL}}}errorCode", "") or ""
    desc = root.findtext(f".//{{{NS_CTL}}}errorDescription", "") or ""
    fault = root.findtext(f".//{{{NS_SOAP}}}Fault/faultstring", "") or ""
    parts = [p for p in (f"error {code}" if code else "", desc, fault if not desc else "") if p]
    return " ".join(parts)


def parse_soap_response(xml_bytes, action):
    try:
        root = ET.fromstring(xml_bytes)
    except ET.ParseError:
        return {}
    resp = root.find(f".//{{{AVT_TYPE}}}{action}Response")
    if resp is None:
        return {}
    return {child.tag.split("}")[-1]: (child.text or "").strip() for child in resp}


# --- relay --------------------------------------------------------------------

def provider_user_agent():
    try:
        with open(PROVIDER_JSON, encoding="utf-8") as f:
            ua = json.load(f).get("user_agent")
        return ua or PLAYER_UA
    except (OSError, ValueError, AttributeError):
        return PLAYER_UA


def local_ip_for(host):
    """The address of ours that the TV can reach (the interface that routes
    to it)."""
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect((host, 9))
        return s.getsockname()[0]
    except OSError:
        return None
    finally:
        s.close()


class Upstream:
    """What the relay serves: one stream URL, probed once so HEAD can be
    answered without touching the provider again."""

    def __init__(self, url, ua):
        self.url = url
        self.ua = ua
        self.mime = mime_for(url)
        self.size = None  # None: live / unknown length -> streamed, not seekable
        self.opens = 0  # upstream connections made (tests, diagnostics)
        self.events = []  # how each served range ended: (why, offset, bytes, seconds)
        self._lock = threading.Lock()
        self._resp = None
        self._pos = 0  # offset the open upstream response yields next
        self._cache = bytearray()
        self._cache_start = 0
        self.probe()

    @property
    def live(self):
        return self.size is None

    @property
    def features(self):
        return DLNA_LIVE if self.live else DLNA_FILE

    def open(self, range_header=None, timeout=20):
        headers = {"User-Agent": self.ua, "Icy-MetaData": "0"}
        if range_header and not self.live:
            headers["Range"] = range_header
        req = urllib.request.Request(self.url, headers=headers)
        self.opens += 1
        return urllib.request.urlopen(req, timeout=timeout)  # follows redirects

    def probe(self):
        for attempt in range(PROBE_RETRIES):
            try:
                r = urllib.request.urlopen(urllib.request.Request(
                    self.url, headers={"User-Agent": self.ua, "Range": "bytes=0-0"}), timeout=15)
                break
            except urllib.error.HTTPError as e:
                e.close()
                if e.code >= 500 and attempt + 1 < PROBE_RETRIES:
                    time.sleep(1)
                    continue
                raise TvError(f"stream refused by provider (HTTP {e.code}) — expired account or another player holding the stream? See Setup", 6)
            except (urllib.error.URLError, OSError) as e:
                raise TvError(f"stream unreachable ({getattr(e, 'reason', e)})", 6)
        with r:
            ct = (r.headers.get("Content-Type") or "").split(";")[0].strip().lower()
            if ct.startswith("video/") or ct.startswith("audio/"):
                if ct in ("video/mp2t", "video/mpeg2"):
                    ct = "video/mpeg"
                self.mime = ct
            m = re.match(r"bytes \d+-\d+/(\d+)", r.headers.get("Content-Range") or "")
            if r.status == 206 and m:
                self.size = int(m.group(1))
            elif r.status == 200 and r.headers.get("Content-Length") and not self.url.lower().split("?")[0].endswith((".ts", ".m3u8")):
                self.size = int(r.headers["Content-Length"])
            r.read(1)


    def audio_codecs(self):
        """Codec names of the audio streams (ffprobe on the file head), or
        None when that cannot be determined (live, no ffprobe, odd file)."""
        if self.live or not shutil.which("ffprobe"):
            return None
        head = io.BytesIO()

        def take(b):
            head.write(b)
            if head.tell() >= PROBE_BYTES:
                raise BrokenPipeError
        try:
            self.serve(0, min(self.size, PROBE_BYTES) - 1, take)
        except (TvError, OSError):
            return None
        with tempfile.NamedTemporaryFile(suffix=os.path.splitext(urllib.parse.urlsplit(self.url).path)[1] or ".bin") as f:
            f.write(head.getvalue())
            f.flush()
            try:
                out = subprocess.run(["ffprobe", "-v", "error", "-show_entries", "stream=codec_type,codec_name",
                                      "-of", "csv=p=0", f.name], capture_output=True, text=True, timeout=20).stdout
            except (OSError, subprocess.TimeoutExpired):
                return None
        codecs = []
        for line in out.splitlines():
            parts = [x.strip() for x in line.split(",")]
            if len(parts) >= 2 and "audio" in parts:
                codecs.append(parts[0] if parts[1] == "audio" else parts[1])
        return codecs

    def needs_transcode(self, mode="auto"):
        if mode == "never" or self.live:
            return False
        if mode == "always":
            return True
        codecs = self.audio_codecs()
        if not codecs:
            return False
        return codecs[0].lower() not in TV_AUDIO  # the TV plays the first track

    # -- file relay: one upstream connection, a cache window, sequential --

    def _close(self):
        if self._resp is not None:
            try:
                self._resp.close()
            except OSError:
                pass
            self._resp = None

    def _reopen(self, offset):
        self._close()
        r = self.open(f"bytes={offset}-" if offset else None)
        if offset and r.status != 206:
            r.close()
            raise TvError("provider ignores range requests; cannot seek", 6)
        self._resp = r
        if offset != self._pos:  # a jump: what we cached is no longer adjacent
            self._cache = bytearray()
            self._cache_start = offset
        self._pos = offset

    def _read(self, n):
        chunk = self._resp.read(n)
        if chunk:
            self._pos += len(chunk)
            self._cache += chunk
            if len(self._cache) > CACHE_BYTES:
                drop = len(self._cache) - CACHE_BYTES
                del self._cache[:drop]
                self._cache_start += drop
        return chunk

    def serve(self, offset, end, write):
        """Write bytes [offset, end] of the file to the client via write();
        returns on EOF, at end, or when the client goes away."""
        t0 = time.monotonic()
        sent = [0]
        first = offset

        def counted(b):
            write(b)
            sent[0] += len(b)

        def note(why):
            self.events.append((why, first, sent[0], round(time.monotonic() - t0, 1)))
            del self.events[:-40]
        with self._lock:
            try:
                self._serve(offset, end, counted)
                note("done")
            except (BrokenPipeError, ConnectionResetError, socket.timeout, TimeoutError) as e:
                note("client-gone " + type(e).__name__)
                return  # client gone (TV closed after its tiny read): keep upstream for the next one
            except (urllib.error.URLError, OSError) as e:
                note("upstream-error " + repr(e)[:60])
                self._close()
                raise

    def _serve(self, offset, end, write):
        stalls = 0
        cached_end = self._cache_start + len(self._cache)
        if self._cache_start <= offset < cached_end:
            piece = bytes(self._cache[offset - self._cache_start:cached_end])
            if end is not None:
                piece = piece[:end - offset + 1]
            write(piece)
            offset += len(piece)
            if end is not None and offset > end:
                return
        if self._resp is None or offset < self._pos or offset > self._pos + SKIP_BYTES:
            self._reopen(offset)
        while self._pos < offset:  # small forward jump: skip through
            if not self._read(min(RELAY_CHUNK, offset - self._pos)):
                self._reopen(offset)
        while True:
            want = RELAY_CHUNK if end is None else min(RELAY_CHUNK, end - self._pos + 1)
            if want <= 0:
                return
            chunk = self._read(want)
            if not chunk:
                self._close()
                if end is not None and self._pos > end:
                    return
                # Edge servers hand out a file in slices and hang up between
                # them; players reconnect at the next byte, and so do we,
                # invisibly to the TV.
                stalls += 1
                if stalls > 5:
                    raise ConnectionError(f"provider keeps ending the stream at {self._pos}")
                self._reopen(self._pos)
                continue
            stalls = 0
            write(chunk)


def parse_range(header, size):
    """'bytes=a-b' -> (a, b) clamped to the file, None when absent/invalid."""
    m = re.match(r"bytes=(\d*)-(\d*)$", (header or "").strip())
    if not m or not size:
        return None
    a, b = m.group(1), m.group(2)
    if a == "" and b == "":
        return None
    if a == "":  # suffix: last b bytes
        n = min(int(b), size)
        return (size - n, size - 1)
    start = int(a)
    stop = min(int(b), size - 1) if b else size - 1
    if start >= size or start > stop:
        return None
    return (start, stop)


class RelayHandler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server_version = "omarchy-iptv/1.0 DLNADOC/1.50 UPnP/1.0"
    sys_version = ""
    timeout = CLIENT_TIMEOUT

    def log_message(self, *a):
        pass

    def _ok_path(self):
        self.server.requests.append((self.command, self.path, self.headers.get("User-Agent", ""), self.headers.get("Range", "")))
        return self.path.split("?")[0] == self.server.relay_path

    def _dlna_headers(self, up):
        self.send_header("Content-Type", up.mime)
        self.send_header("transferMode.dlna.org", "Streaming")
        self.send_header("contentFeatures.dlna.org", up.features)
        self.send_header("Accept-Ranges", "none" if up.live else "bytes")
        self.send_header("Connection", "close")
        self.close_connection = True

    def _transcode_path(self):
        return self.server.ts_path and self.path.split("?")[0] == self.server.ts_path

    def _ts_headers(self):
        self.send_header("Content-Type", "video/mpeg")
        self.send_header("transferMode.dlna.org", "Streaming")
        self.send_header("contentFeatures.dlna.org", DLNA_LIVE)
        self.send_header("Accept-Ranges", "none")
        self.send_header("Connection", "close")
        self.close_connection = True

    def do_HEAD(self):
        up = self.server.upstream
        if self._transcode_path():
            self.server.requests.append((self.command, self.path, self.headers.get("User-Agent", ""), ""))
            self.send_response(200)
            self._ts_headers()
            self.end_headers()
            return
        if not self._ok_path():
            self.send_error(404)
            return
        self.send_response(200)
        self._dlna_headers(up)
        if not up.live:
            self.send_header("Content-Length", str(up.size))
        self.end_headers()

    def do_GET(self):
        up = self.server.upstream
        if self._transcode_path():
            self.server.requests.append((self.command, self.path, self.headers.get("User-Agent", ""), ""))
            self._get_transcoded()
            return
        if not self._ok_path():
            self.send_error(404)
            return
        if up.live:
            self._get_live(up)
        else:
            self._get_file(up)

    def _get_transcoded(self):
        """ffmpeg reads the file through our own relay path on loopback (so
        the cache, seeks and provider reconnects all apply), converts the
        audio and hands the TV an MPEG-TS stream."""
        src = f"http://127.0.0.1:{self.server.server_address[1]}{self.server.relay_path}"
        cmd = ["ffmpeg", "-nostdin", "-loglevel", "error", "-i", src,
               "-map", "0:v:0", "-map", "0:a:0", "-c:v", "copy", "-c:a", "ac3", "-b:a", "384k",
               "-f", "mpegts", "-muxdelay", "0", "pipe:1"]
        try:
            proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        except OSError:
            self.send_error(500, "ffmpeg not available")
            return
        self.send_response(200)
        self._ts_headers()
        self.end_headers()
        self.server.served += 1
        try:
            while True:
                chunk = proc.stdout.read(RELAY_CHUNK)
                if not chunk:
                    break
                self.wfile.write(chunk)
        except (BrokenPipeError, ConnectionResetError, OSError):
            pass
        finally:
            if proc.poll() is None:
                proc.terminate()
                try:
                    proc.wait(5)
                except subprocess.TimeoutExpired:
                    proc.kill()
            err = proc.stderr.read().decode(errors="replace").strip()
            if err and proc.returncode not in (0, None, -15):
                warn("ffmpeg: " + err.splitlines()[-1])

    def _get_live(self, up):
        try:
            r = up.open()
        except urllib.error.HTTPError as e:
            self.send_error(502, f"provider HTTP {e.code}")
            return
        except (urllib.error.URLError, OSError):
            self.send_error(502, "provider unreachable")
            return
        with r:
            self.send_response(200)
            self._dlna_headers(up)
            self.end_headers()
            self.server.served += 1
            try:
                while True:
                    chunk = r.read(RELAY_CHUNK)
                    if not chunk:
                        break
                    self.wfile.write(chunk)
            except (BrokenPipeError, ConnectionResetError, OSError):
                pass  # TV closed the connection: normal on stop / channel change

    def _get_file(self, up):
        rng = parse_range(self.headers.get("Range"), up.size)
        if rng:
            start, stop = rng
            self.send_response(206)
            self._dlna_headers(up)
            self.send_header("Content-Range", f"bytes {start}-{stop}/{up.size}")
            self.send_header("Content-Length", str(stop - start + 1))
        else:
            start, stop = 0, up.size - 1
            self.send_response(200)
            self._dlna_headers(up)
            self.send_header("Content-Length", str(up.size))
        self.end_headers()
        self.server.served += 1
        try:
            up.serve(start, stop, self.wfile.write)
        except (urllib.error.URLError, OSError):
            pass  # mid-stream provider failure: the TV sees a short body and retries


class RelayServer(http.server.ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True

    def server_bind(self):
        # HTTPServer.server_bind() reverse-resolves the bind address for
        # server_name; on 0.0.0.0 that is a 5 s DNS stall before every cast.
        socketserver.TCPServer.server_bind(self)
        self.server_name = "omarchy-iptv"
        self.server_port = self.server_address[1]

    def __init__(self, port, upstream):
        super().__init__(("0.0.0.0", port), RelayHandler)
        self.upstream = upstream
        self.relay_path = "/" + secrets.token_urlsafe(18) + "/stream" + ("." + upstream.mime.split("/")[-1])
        self.ts_path = None  # set when the audio is converted: the TV plays this one instead
        self.served = 0
        self.requests = []  # (method, path, user-agent, range): what the TV asked for


def start_relay(url, port, tv_host, transcode="auto"):
    """Returns (server, url for the TV, upstream, mime, dlna features)."""
    ip = local_ip_for(tv_host)
    if not ip:
        raise TvError("no route to the TV from this machine", 4)
    up = Upstream(url, provider_user_agent())
    try:
        srv = RelayServer(port, up)
    except OSError as e:
        raise TvError(f"relay could not listen on port {port} ({e.strerror or e})", 7)
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    public = f"http://{ip}:{srv.server_address[1]}"
    if up.needs_transcode(transcode):
        if not shutil.which("ffmpeg"):
            warn("audio codec not supported by the TV and ffmpeg is missing (omarchy pkg add ffmpeg); sending as is")
        else:
            srv.ts_path = srv.relay_path.rsplit("/", 1)[0] + "/converted.ts"
            return srv, public + srv.ts_path, up, "video/mpeg", DLNA_LIVE
    return srv, public + srv.relay_path, up, up.mime, up.features


# --- play ---------------------------------------------------------------------

def mime_for(url):
    path = urllib.parse.urlsplit(url).path
    ext = os.path.splitext(path)[1].lower()
    return MIME.get(ext, "video/mpeg")


def tv_stream_url(url, live_format=DEFAULT_LIVE_FORMAT):
    """Xtream live streams are cached as HLS (.m3u8) for mpv; the same stream
    is served as plain MPEG-TS, which TVs' DLNA players handle far more
    reliably. Anything else passes through untouched."""
    if live_format == "ts":
        return re.sub(r"^(https?://[^/]+/live/[^/]+/[^/]+/[^/?#]+)\.m3u8(?=$|\?)", r"\1.ts", url)
    return url


def didl_metadata(url, title, mime=None, features="*"):
    mime = mime or mime_for(url)
    return (
        '<DIDL-Lite xmlns="urn:schemas-upnp-org:metadata-1-0/DIDL-Lite/" '
        'xmlns:dc="http://purl.org/dc/elements/1.1/" '
        'xmlns:upnp="urn:schemas-upnp-org:metadata-1-0/upnp/" '
        'xmlns:sec="http://www.sec.co.kr/">'
        '<item id="0" parentID="-1" restricted="1">'
        f"<dc:title>{escape(title)}</dc:title>"
        "<upnp:class>object.item.videoItem</upnp:class>"
        f'<res protocolInfo="http-get:*:{mime}:{features}">{escape(url)}</res>'
        "</item></DIDL-Lite>"
    )


def resolve_url(sid):
    try:
        p = subprocess.run([SYNC, "--play-url", "--id", str(sid)],
                           capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise TvError(f"could not resolve stream: {e}", 6)
    if p.returncode != 0 or not p.stdout.strip():
        raise TvError(f"could not resolve stream: {p.stderr.strip() or 'unknown id'}", 6)
    return p.stdout.strip()


def require_tv():
    tv = load_tv()
    if not tv.get("control_url"):
        raise TvError("no TV selected (Setup → Stream to TV → Find TVs)", 3)
    return tv


def send_uri(ctl, url, title, mime=None, features="*"):
    try:  # a renderer mid-playback may reject a new URI until stopped
        soap_call(ctl, "Stop", {"InstanceID": 0}, timeout=FIRST_CONTACT_TIMEOUT)
    except TvError as e:
        if e.code == 4:
            raise
    soap_call(ctl, "SetAVTransportURI", {
        "InstanceID": 0,
        "CurrentURI": url,
        "CurrentURIMetaData": didl_metadata(url, title, mime, features),
    }, timeout=FIRST_CONTACT_TIMEOUT)
    soap_call(ctl, "Play", {"InstanceID": 0, "Speed": "1"})


def watch_playback(ctl, poll=POLL_SECONDS, grace=START_GRACE, stop_event=None):
    """Follow the TV's transport state until playback ends. Returns normally
    when the TV stops after having played (remote, end of file); raises
    TvError(8) when it never plays or stops with an error."""
    started = time.monotonic()
    played = False
    idle = 0
    misses = 0
    while not (stop_event and stop_event.is_set()):
        time.sleep(poll)
        try:
            info = soap_call(ctl, "GetTransportInfo", {"InstanceID": 0})
        except TvError as e:
            # A TV busy scanning a big file can stop answering UPnP for a
            # while; only a sustained silence counts as gone.
            misses += 1
            if e.code != 4 or misses >= 10:
                raise
            continue
        misses = 0
        state = info.get("CurrentTransportState", "")
        status = info.get("CurrentTransportStatus", "")
        if state in ("PLAYING", "PAUSED_PLAYBACK", "RECORDING"):
            if not played:
                sys.stdout.write("PLAYING\n")
                sys.stdout.flush()
            played = True
            idle = 0
            continue
        if status and status != "OK":
            raise TvError(f"TV stopped with {status} (it could not play this stream)", 8)
        if state in ("STOPPED", "NO_MEDIA_PRESENT"):
            if played:
                idle += 1
                if idle >= 2:
                    return
            elif time.monotonic() - started > grace:
                raise TvError("TV never started playing (gave up after %ds)" % int(grace), 8)
        elif time.monotonic() - started > grace and not played:
            raise TvError(f"TV stuck in {state or 'unknown state'}", 8)


def cast(url, title, relay=None, wait=True):
    tv = require_tv()
    url = tv_stream_url(url, tv.get("live_format") or DEFAULT_LIVE_FORMAT)
    ctl = tv["control_url"]
    if relay is None:
        relay = tv.get("relay", True) is not False
    if not relay:
        send_uri(ctl, url, title)
        if wait:
            watch_playback(ctl)
        return
    srv, public_url, up, mime, features = start_relay(
        url, int(tv.get("relay_port") or RELAY_PORT),
        tv.get("host") or urllib.parse.urlsplit(ctl).hostname,
        tv.get("transcode_audio") or "auto")
    stopping = threading.Event()

    def on_term(*_):
        stopping.set()
        raise SystemExit(0)
    signal.signal(signal.SIGTERM, on_term)
    signal.signal(signal.SIGINT, on_term)
    try:
        send_uri(ctl, public_url, title, mime, features)
        if wait:
            watch_playback(ctl, stop_event=stopping)
    finally:
        srv.shutdown()
        srv.server_close()
        if stopping.is_set():
            try:
                soap_call(ctl, "Stop", {"InstanceID": 0}, timeout=5)
            except TvError:
                pass


def transport(action):
    tv = require_tv()
    args = {"InstanceID": 0}
    if action == "Play":
        args["Speed"] = "1"
    return soap_call(tv["control_url"], action, args)


def status():
    tv = require_tv()
    info = soap_call(tv["control_url"], "GetTransportInfo", {"InstanceID": 0})
    out = {
        "tv": tv.get("name", ""),
        "state": info.get("CurrentTransportState", ""),
        "status": info.get("CurrentTransportStatus", ""),
    }
    try:
        pos = soap_call(tv["control_url"], "GetPositionInfo", {"InstanceID": 0})
        out["position"] = pos.get("RelTime", "")
        out["duration"] = pos.get("TrackDuration", "")
    except TvError:
        pass
    return out


def select(location=None, host=None):
    cands = [location] if location else []
    if host:
        cands += [f"http://{host}:{port}{p}" for port, paths in SAMSUNG_PROBES for p in paths]
    for loc in cands:
        d = describe(loc)
        if d:
            prev = load_tv()
            d["live_format"] = prev.get("live_format") or DEFAULT_LIVE_FORMAT
            d["cast_mode"] = True  # picking a TV means: play there
            save_json(TV_JSON, d)
            return d
    raise TvError("no DLNA renderer (AVTransport) found at that address", 4)


def main():
    ap = argparse.ArgumentParser()
    g = ap.add_mutually_exclusive_group(required=True)
    g.add_argument("--discover", action="store_true")
    g.add_argument("--select", action="store_true")
    g.add_argument("--forget", action="store_true")
    g.add_argument("--play", action="store_true")
    g.add_argument("--stop", action="store_true")
    g.add_argument("--pause", action="store_true")
    g.add_argument("--resume", action="store_true")
    g.add_argument("--status", action="store_true")
    ap.add_argument("--location", default="", help="device description URL (with --select)")
    ap.add_argument("--host", default="", help="TV address (with --select)")
    ap.add_argument("--id", default="", help="catalog id (with --play)")
    ap.add_argument("--title", default="IPTV")
    ap.add_argument("--no-relay", action="store_true", help="hand the raw URL to the TV (no local relay)")
    ap.add_argument("--no-wait", action="store_true", help="with --no-relay: return right after Play")
    ap.add_argument("url", nargs="?", default="")
    a = ap.parse_args()
    try:
        if a.discover:
            json.dump(discover(), sys.stdout)
        elif a.select:
            if not (a.location or a.host):
                die("--select needs --location or --host", 2)
            d = select(a.location, a.host)
            json.dump(d, sys.stdout)
        elif a.forget:
            try:
                os.remove(TV_JSON)
            except FileNotFoundError:
                pass
        elif a.play:
            url = resolve_url(a.id) if a.id else a.url
            if not url:
                die("--play needs --id <id> or a url", 2)
            cast(url, a.title, relay=(False if a.no_relay else None), wait=not a.no_wait)
        elif a.stop:
            transport("Stop")
        elif a.pause:
            transport("Pause")
        elif a.resume:
            transport("Play")
        elif a.status:
            json.dump(status(), sys.stdout)
    except TvError as e:
        die(str(e), e.code)


if __name__ == "__main__":
    main()
